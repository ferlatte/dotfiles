<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
This command enables the agent:
launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.ferlatte.omnifocus-run-plugin.plist

This command runs it immediately to test it:
launchctl kickstart -k gui/$(id -u)/net.ferlatte/net.ferlatte.omnifocus-run-plugin
-->
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>net.ferlatte.omnifocus-run-plugin</string>
        <key>Program</key>
        <string>/Users/mark/bin/omnifocus-run-plugin</string>
        <key>StartInterval</key>
        <integer>3600</integer>
        <key>StandardOutPath</key>
        <string>/Users/mark/Library/Logs/omnifocus-run-plugin.log</string>
        <key>StandardErrorPath</key>
        <string>/Users/mark/Library/Logs/omnifocus-run-plugin.log</string>
    </dict>
</plist>

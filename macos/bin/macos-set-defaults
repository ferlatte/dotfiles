#! /bin/sh

set -eu

# Close any open System Settings panes, to prevent them from overriding
# settings we’re about to change. Ask whether it's running before quitting;
# quit() doesn't report that, so asking it afterwards never re-opened anything.
systemSettingsRunning=$(osascript -l JavaScript -e 'Application("System Settings").running()')
if test "$systemSettingsRunning" = "true"; then
    osascript -l JavaScript -e 'Application("System Settings").quit()' > /dev/null
fi

# This displays file extensions in the Finder and file picker
# UI.
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# This removes Trash items that are older than 30 days.
defaults write com.apple.finder FXRemoveOldTrashItems -bool true

# Re-open System Preferences if it was open when we started
if test "$systemSettingsRunning" = "true"; then
    open -a "System Settings"
fi

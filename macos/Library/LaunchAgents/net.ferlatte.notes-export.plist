<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
This command enables the agent:
launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.ferlatte.notes-export.plist

This command runs it immediately to test it:
launchctl kickstart -k gui/$(id -u)/net.ferlatte/net.ferlatte.notes-export
-->
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>net.ferlatte.notes-export</string>
        <key>ProgramArguments</key>
        <array>
            <string>/Users/mark/bin/macos-export-notes</string>
        </array>
        <key>StandardOutPath</key>
        <string>/Users/mark/Library/Logs/notes-export.log</string>
        <key>StandardErrorPath</key>
        <string>/Users/mark/Library/Logs/notes-export.log</string>
        <key>StartInterval</key>
        <integer>3600</integer>
    </dict>
</plist>
